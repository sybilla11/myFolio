---
import { Image } from 'astro:assets';
import profile from '../assets/profile.jpeg';
---

<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-text">
      <p class="eyebrow">Staff Software Engineer</p>
      <h1>
        Frontend architecture for <em>regulated, high-stakes</em> products.
      </h1>
      <p class="lead">
        10+ years building enterprise software for financial services and fintech — currently at BILL, leading
        Angular/React architecture for international payments and Banking-as-a-Service. Full-stack when it counts
        (Java/Spring on the back end), and increasingly focused on AI-augmented engineering: agent workflows, MCP
        servers, and LLM evaluation as part of how I build, not just what I build.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#projects">See my work</a>
        <a class="btn btn-outline" href="/Sybilla_Dantas_Resume.pdf" target="_blank" rel="noopener">
          Resume ↗
        </a>
        <a class="btn btn-outline" href="https://www.linkedin.com/in/sybilla-dantas-41861213/" target="_blank" rel="noopener">
          LinkedIn
        </a>
      </div>
    </div>
    <div class="hero-photo">
      <Image src={profile} alt="Sybilla Dantas" width={360} height={360} />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-24) 0 var(--space-16);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-16);
    align-items: center;
  }

  .hero-text h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    margin: var(--space-4) 0 var(--space-6);
  }

  .hero-text h1 em {
    font-style: italic;
    color: var(--accent);
  }

  .lead {
    font-size: 1.125rem;
    color: var(--text-muted);
    max-width: 520px;
    margin-bottom: var(--space-8);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero-photo {
    justify-self: center;
  }

  .hero-photo :global(img) {
    width: 300px;
    height: 300px;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
  }

  @media (max-width: 800px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .lead {
      margin-left: auto;
      margin-right: auto;
    }

    .hero-ctas {
      justify-content: center;
    }

    .hero-photo {
      order: -1;
    }

    .hero-photo :global(img) {
      width: 200px;
      height: 200px;
    }
  }
</style>
